# Образец секретов для ЛОКАЛЬНОГО запуска.
# Скопируй этот файл в .env, подставь значения и запусти:  python amo_export.py
# (для локального чтения .env можно поставить python-dotenv, либо задать переменные вручную)
#
# В GitHub эти же два значения задаются как Secrets (Settings → Secrets and variables → Actions),
# файл .env в репозиторий НЕ коммитим (он в .gitignore).

# Долгоживущий токен интеграции amoCRM (шлётся как Authorization: Bearer <токен>)
AMO_TOKEN=

# Содержимое JSON-ключа сервис-аккаунта Google (одной строкой целиком)
GOOGLE_SERVICE_ACCOUNT_JSON=
